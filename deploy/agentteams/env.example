# Copy to deploy/agentteams/.env — gitignored. Never commit.

TOOLLAW_SIDECAR_HOME=/var/lib/toollaw
TOOLLAW_FORBIDDEN=/opt/scout,/opt/lockin

# AgentTeams official installer (OpenAI-compat). Rotate if the key was ever pasted in chat.
LLM_PROVIDER=openai-compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
DEFAULT_MODEL=gpt-4o
